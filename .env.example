# ==============================================================================
# CONFIGURAÇÕES DO CLIENTE (VITE / FRONTEND)
# ==============================================================================

# URL da instância Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anon do Supabase (acesso client-side com RLS)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Webhook de integração do Chatbot de IA (n8n / webhook externo)
VITE_WEBHOOK_URL=https://webhook.exemplo.com/webhook/chatbot-adv/site

# ID da pasta raiz no Google Drive do escritório para arquivos de clientes/casos
VITE_GOOGLE_DRIVE_ROOT_FOLDER_ID=seu_folder_id_google_drive

# (Opcional) Domínio customizado para CDN de mídia / Cloudflare R2
VITE_STORAGE_CUSTOM_DOMAIN=arquivos.edvaldorodrigues.com.br

# ==============================================================================
# CONFIGURAÇÕES DE SERVIDOR & EDGE FUNCTIONS (BACKEND / VERCEL)
# ATENÇÃO: NUNCA exponha estas chaves no bundle público do frontend!
# ==============================================================================

# Chave mestra administrativa do Supabase (Service Role)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Credenciais da Google Service Account (acesso servidor ao Google Drive)
GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-servico@seu-projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# GATEWAY FINANCEIRO ASAAS (EDGE FUNCTIONS DO SUPABASE)
# ==============================================================================

# Chave de API do Asaas (Sandbox ou Produção)
ASAAS_API_KEY=sua_chave_api_asaas_aqui

# Ambiente da API Asaas: 'sandbox' ou 'production'
ASAAS_ENVIRONMENT=sandbox

# Token de validação secreta do Webhook Asaas (cabeçalho asaas-access-token)
ASAAS_WEBHOOK_ACCESS_TOKEN=seu_token_secreto_webhook_asaas
